# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/agriplace

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=supersecretkey_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Microservice URLs (for local non-docker testing)
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
MARKETPLACE_SERVICE_URL=http://localhost:8003
ORDER_SERVICE_URL=http://localhost:8004
LOGISTICS_SERVICE_URL=http://localhost:8005
PAYMENT_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
ML_SERVICE_URL=http://localhost:8008
